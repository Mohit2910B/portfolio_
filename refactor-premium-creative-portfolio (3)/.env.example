# ---------------------------------------------------------------
# DATABASE — MySQL 8.0 local Windows setup
# Replace YOUR_MYSQL_PASSWORD with your real local MySQL root password.
# Never commit the real password.
# ---------------------------------------------------------------
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/smeet_portfolio

# Optional individual parameters for scripts/docs:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smeet_portfolio
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# ---------------------------------------------------------------
# MEDIA STORAGE
# Uploaded videos / thumbnails are written to this folder on the
# server and served through /api/files/<filename>.
# ---------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=300

# ---------------------------------------------------------------
# FIRST RUN SEED ADMIN (only used when the admins table is empty)
# Change this password for production.
# ---------------------------------------------------------------
SEED_ADMIN_NAME=Mohit Babariya
SEED_ADMIN_EMAIL=admin@mohitbabariya.studio
SEED_ADMIN_USERNAME=mohit
SEED_ADMIN_PASSWORD=Mohit@2026

# Public site origin (used for absolute asset URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
