# ===============================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES (ONLY 4 REQUIRED)
# ===============================================================

# 1. Remote PostgreSQL Database connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 2. Resend API key for sending client OTP emails
RESEND_API_KEY=re_your_api_key_here

# 3. Verified Resend sender email (domain verified in resend.com)
RESEND_FROM_EMAIL=Mohit Babariya <noreply@mohitbabariya.in>

# 4. Your Studio CMS admin password
SEED_ADMIN_PASSWORD=YourAdminPasswordHere