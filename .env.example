# ---------------------------------------------------------------
# POSTGRESQL DATABASE
# You can provide either DATABASE_URL or individual DB_* parameters:
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Optional individual parameters:
DB_HOST=your_db_host_here
DB_PORT=5432
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_SSL=true


# ---------------------------------------------------------------
# MEDIA STORAGE
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=300

# ---------------------------------------------------------------
# FIRST RUN SEED ADMIN
SEED_ADMIN_NAME=your_admin_name_here
SEED_ADMIN_EMAIL=your_admin_email_here
SEED_ADMIN_USERNAME=your_admin_username_here
SEED_ADMIN_PASSWORD=your_admin_password_here

# Public site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email OTP + email notifications
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Portfolio <noreply@yourdomain.com>
NOTIFICATION_EMAIL=your_notification_email_here

# Mobile OTP (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_from_number_here

# AI assistant
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini