# ===============================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ===============================================================

# 1. Remote PostgreSQL Database (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 2. Vercel Blob Storage (for media uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# 3. Resend API key (transactional email — OTP, enquiry notifications)
RESEND_API_KEY=re_your_api_key_here

# 4. Verified Resend sender email (domain verified at resend.com)
RESEND_FROM_EMAIL=Mohit Babariya <noreply@mohitbabariya.in>

# 5. Session signing secret (any random 32+ char string)
AUTH_SECRET=generate-a-random-secret-here-min-32-chars

# 6. Initial admin password (used during first database bootstrap)
SEED_ADMIN_PASSWORD=YourAdminPasswordHere

# 7. Public site URL (used for SEO, email links)
PUBLIC_SITE_URL=https://mohitbabariya.in