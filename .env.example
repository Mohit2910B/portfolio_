# ---------------------------------------------------------------
# 1. POSTGRESQL DATABASE (REQUIRED IN VERCEL)
# Use your remote PostgreSQL database connection string (Neon, Supabase, Vercel Postgres, AWS RDS, etc.):
DATABASE_URL=postgresql://postgres:password@ep-xyz-123.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------
# 2. RESEND EMAIL & OTP SERVICE (REQUIRED FOR CLIENT OTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sending domain sender (verified domain in resend.com/domains)
RESEND_FROM_EMAIL=Mohit Babariya <noreply@mohitbabariya.in>
EMAIL_FROM=Mohit Babariya <noreply@mohitbabariya.in>

# Admin email to receive incoming enquiry submissions & alerts
NOTIFICATION_EMAIL=mohitbabariyaa@gmail.com

# ---------------------------------------------------------------
# 3. SECURE ADMIN CREDENTIALS (REQUIRED FOR STUDIO CMS)
# Set your initial administrator credentials:
SEED_ADMIN_NAME=MOHIT BABARIYA
SEED_ADMIN_EMAIL=mohitbabariyaa@gmail.com
SEED_ADMIN_USERNAME=Mohit
SEED_ADMIN_PASSWORD=YourSecurePasswordHere

# Secret used to sign admin session cookies and OTP challenges (optional, defaults to crypto key)
AUTH_SECRET=your-random-32-character-secret-key-here

# ---------------------------------------------------------------
# 4. SITE ORIGIN
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ---------------------------------------------------------------
# 5. OPTIONAL SERVICES (Leave blank if not used)
# OpenAI for interactive AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (Optional SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=